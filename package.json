{
  "name": "zynchat",
  "version": "2.0.0",
  "description": "ZynChat — Enterprise Messaging Platform",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "start:secure": "nginx -c $PWD/nginx/zynchat.conf & node server.js",
    "desktop": "electron .",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux AppImage"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.3",
    "express-session": "^1.17.3",
    "socket.io": "^4.7.5",
    "sql.js": "^1.14.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.zynchat.app",
    "productName": "ZynChat",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "icon": "public/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/icon.png"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
