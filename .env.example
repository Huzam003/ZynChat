# ZynChat Environment Variables
PORT=3001
SESSION_SECRET=change-this-to-a-long-random-string

# ShieldWatch Security (RASP)
SW_ENABLED=true
SW_CEREBRO_ADDR=localhost:3002
SW_API_TOKEN=change-this-to-a-secret-token
SW_ADMIN_PASS=change-this-to-a-secure-password
SW_SESSION_SECRET=change-this-to-another-random-string
