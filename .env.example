# ZynChat Security Configuration
# ──────────────────────────────

# Main Server
PORT=3001
SESSION_SECRET=zynchat-dev-secret-2024
NODE_ENV=development

# ShieldWatch Protection
SW_ENABLED=true
SW_CEREBRO_ADDR=localhost:3002
SW_APP_ID=zynchat
SW_LOG_ONLY=false

# ShieldWatch Internal (Synced from collector's .env)
SW_API_TOKEN=sw-internal-token-xyz
