{
  "name": "zynchat",
  "version": "2.2.0-hardened",
  "description": "ZynChat — Enterprise Messaging Platform",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "start:secure": "python3 launch.py secure",
    "stop": "fuser -k 3001/tcp 3002/tcp 8080/tcp || true",
    "test": "jest",
    "desktop": "electron .",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux AppImage"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.3",
    "express-session": "^1.17.3",
    "helmet": "^7.1.0",
    "socket.io": "^4.7.5",
    "sql.js": "^1.14.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.4",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "jest": "^29.7.0"
  },
  "build": {
    "appId": "com.zynchat.app",
    "productName": "ZynChat",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "icon": "public/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/icon.png"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
